#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Name: TODO
# ID: TODO
#
# Description: This version uses the iaddq instruction added to the
# PIPE control logic to reduce immediate-update instruction count.  The
# main loop is unrolled by eight words so that loop overhead and branch
# cost are amortized across several copies while preserving a compact
# remainder loop for lengths that are not multiples of eight.
#
##################################################################
# Do not modify this portion
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
ncopy:

##################################################################
# You can modify this portion
	xorq %rax,%rax          # count = 0
	iaddq $-8,%rdx          # len -= 8 for the unrolled loop test
	jl RemPrep             # fewer than 8 elements remain

Loop8:
	mrmovq 0(%rdi), %r8
	mrmovq 8(%rdi), %r9
	mrmovq 16(%rdi), %r10
	mrmovq 24(%rdi), %r11
	rmmovq %r8, 0(%rsi)
	rmmovq %r9, 8(%rsi)
	andq %r8,%r8
	jle L8_1
	iaddq $1,%rax
L8_1:
	rmmovq %r10, 16(%rsi)
	rmmovq %r11, 24(%rsi)
	andq %r9,%r9
	jle L8_2
	iaddq $1,%rax
L8_2:
	andq %r10,%r10
	jle L8_3
	iaddq $1,%rax
L8_3:
	andq %r11,%r11
	jle L8_4
	iaddq $1,%rax
L8_4:
	mrmovq 32(%rdi), %r8
	mrmovq 40(%rdi), %r9
	mrmovq 48(%rdi), %r10
	mrmovq 56(%rdi), %r11
	rmmovq %r8, 32(%rsi)
	rmmovq %r9, 40(%rsi)
	andq %r8,%r8
	jle L8_5
	iaddq $1,%rax
L8_5:
	rmmovq %r10, 48(%rsi)
	rmmovq %r11, 56(%rsi)
	andq %r9,%r9
	jle L8_6
	iaddq $1,%rax
L8_6:
	andq %r10,%r10
	jle L8_7
	iaddq $1,%rax
L8_7:
	andq %r11,%r11
	jle L8_8
	iaddq $1,%rax
L8_8:
	iaddq $64,%rdi
	iaddq $64,%rsi
	iaddq $-8,%rdx
	jge Loop8

RemPrep:
	iaddq $8,%rdx          # restore remaining length to 0..7
	jle Done

RemLoop:
	mrmovq (%rdi), %r8
	rmmovq %r8, (%rsi)
	andq %r8,%r8
	jle RemNpos
	iaddq $1,%rax
RemNpos:
	iaddq $8,%rdi
	iaddq $8,%rsi
	iaddq $-1,%rdx
	jg RemLoop
##################################################################
# Do not modify the following section of code
# Function epilogue.
Done:
	ret
##################################################################
# Keep the following label at the end of your function
End:
#/* $end ncopy-ys */
