# Name: TODO
# ID: TODO
# copy.ys - Copy a block and return the XOR checksum.

.pos 0
    irmovq stack, %rsp
    irmovq src, %rdi
    irmovq dest, %rsi
    irmovq $3, %rdx
    call copy_block
    halt

copy_block:
    xorq %rax, %rax
    andq %rdx, %rdx
    jle done
    irmovq $8, %r8
    irmovq $1, %r9
loop:
    mrmovq (%rdi), %r10
    rmmovq %r10, (%rsi)
    xorq %r10, %rax
    addq %r8, %rdi
    addq %r8, %rsi
    subq %r9, %rdx
    jg loop
done:
    ret

.align 8
src:
    .quad 0x00a
    .quad 0x0b0
    .quad 0xc00
dest:
    .quad 0x111
    .quad 0x222
    .quad 0x333

.pos 0x200
stack:
